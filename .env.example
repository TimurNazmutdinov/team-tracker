# Настройки team-tracker. Скопируйте файл в .env и при необходимости измените значения:
#   Windows:  copy .env.example .env
#   Linux/macOS:  cp .env.example .env
# Файл .env в репозиторий не попадает. Строки с # — комментарии; чтобы включить пример, уберите #.

# --- Запуск на своём компьютере (npm run start или start.cmd) ---

# Адрес, на котором слушает сервер.
# 127.0.0.1 — только этот компьютер (по умолчанию).
# 0.0.0.0 — доступ коллегам по локальной сети (нужно правило брандмауэра, см. README).
HOST=127.0.0.1

# Порт: трекер открывается на http://localhost:3000
PORT=3000

# Папка встроенной базы PGlite (создаётся сама). Относительный путь считается от папки проекта.
# Используется, только если не задан DATABASE_URL.
DATA_DIR=./local-data

# Самостоятельная регистрация на экране входа. По умолчанию закрыта (false):
# первого администратора создаёт `npm run admin:create`, остальных участников — администратор
# на экране «Люди» с временным паролем. Включайте (true) только в доверенной сети.
ALLOW_REGISTRATION=false

# --- Резервные копии (ADR-012) ---
# Папка для копий. Её можно выбрать и в интерфейсе («Настройки → Резервные копии»): выбор там
# сильнее этого значения. Подойдёт папка облачного диска, например D:\Dropbox\tracker-backups.
# BACKUP_DIR=./backups
# Автоматические копии: ежедневно в это время (по времени компьютера) и при запуске, если
# последней копии больше суток. BACKUP_AUTO=false выключает автокопирование.
# BACKUP_AUTO=true
# BACKUP_TIME=18:00
# Сколько хранить: последние ежедневные и ежемесячные копии.
# BACKUP_KEEP_DAILY=30
# BACKUP_KEEP_MONTHLY=12

# --- Режим с PostgreSQL (Docker Compose или свой сервер) ---

# Если задан DATABASE_URL, встроенная база не используется.
# DATABASE_URL=postgres://tracker:пароль@localhost:5432/tracker

# Docker Compose: пароль базы ОБЯЗАТЕЛЕН (буквы и цифры, без спецсимволов), без него
# `docker compose up` не запустится.
# POSTGRES_PASSWORD=
# Часовой пояс контейнера: по нему считается время ежедневной копии (BACKUP_TIME), например Europe/Moscow.
# TZ=UTC
# Порт на компьютере, на котором Compose открывает трекер (по умолчанию 3000).
# APP_PORT=3000

# true — только если перед трекером стоит HTTPS-прокси; иначе вход по cookie не сработает.
COOKIE_SECURE=false
