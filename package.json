{
  "name": "team-tracker",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Трекер задач и спринтов для команд разработки",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "server": "tsx server/src/main.ts",
    "server:dev": "tsx watch server/src/main.ts",
    "db:seed": "tsx server/src/seed-cli.ts",
    "load:data": "tsx server/src/loadgen-cli.ts",
    "db:generate": "drizzle-kit generate --config server/drizzle.config.ts",
    "start": "node scripts/start.mjs",
    "admin:create": "tsx server/src/admin-cli.ts",
    "backup": "tsx server/src/backup-cli.ts",
    "restore": "tsx server/src/restore-cli.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.8",
    "@tanstack/react-query": "^5.105.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fflate": "^0.8.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "read-excel-file": "^9.3.13",
    "tsx": "^4.23.15",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
